---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Kanishka Das" description="Page not found.">
	<section class="not-found">
		<p class="code">404</p>
		<h1>Nothing's here.</h1>
		<p>Whatever you were looking for either moved or never existed. Let's get you back somewhere useful.</p>
		<div class="links">
			<a class="cta" href="/">Home →</a>
			<a class="cta-ghost" href="/projects">Projects</a>
			<a class="cta-ghost" href="/blog">Blog</a>
		</div>
	</section>
</Layout>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		min-height: calc(100dvh - 12rem);
		max-width: var(--max-width-prose);
		padding: var(--space-5) 0 var(--space-6);
	}

	.code {
		font-family: var(--font-code);
		font-size: 14px;
		color: var(--accent-text);
		padding-bottom: var(--space-2);
	}

	h1 {
		font-size: 32px;
		padding-bottom: var(--space-2);
	}

	.not-found > p:not(.code) {
		color: var(--text-secondary);
		padding-bottom: var(--space-4);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		font-family: var(--font-heading);
		font-size: 14px;
	}

	.cta,
	.cta-ghost {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 var(--space-3);
		border-radius: 6px;
		font-size: 14px;
	}

	.cta {
		background: var(--accent);
		color: #fff;
	}

	.cta:hover {
		text-decoration: none;
		filter: brightness(1.1);
	}

	.cta-ghost {
		border: 1px solid var(--border);
		color: var(--text-primary);
	}

	.cta-ghost:hover {
		text-decoration: none;
		border-color: var(--accent);
	}
</style>
