---
import Layout from '../layouts/Layout.astro';
import ParticleCube from '../components/ParticleCube.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredIds = ['auraalloc', 'niyom', 'ssg-pharma'];
const featured = featuredIds
	.map((id) => allProjects.find((p) => p.id === id))
	.filter((p) => p !== undefined);

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const latestPost = posts[0];
---

<Layout title="Kanishka Das (bhajamaach)" description="I'm Kanishka Das — bhajamaach online. Systems engineering, AI infra, and low-level performance work.">
	<section class="hero">
		<div>
			<h1>I build the parts of the stack most people skip.</h1>
			<p class="lede">
				 I'm Kanishka — bhajamaach if that's where you know me from. I don't build the parts people click on, I
        build what's underneath: allocators, renderers, shells, the stuff nobody notices until it breaks. Lately I've been spending
				more of it on AI infra, figuring out how inference and serving actually work.
			</p>
			<div class="cta-row">
				<a class="cta" href="/projects">See what I've built →</a>
				<a class="cta-ghost" href="/resume.pdf" target="_blank" rel="noreferrer">Resume</a>
			</div>
		</div>
		<ParticleCube />
	</section>

	{featured.length > 0 && (
		<section class="featured">
			<div class="section-head">
				<h2>Selected work</h2>
				<a href="/projects">all projects →</a>
			</div>
			<ul class="grid">
				{featured.map((project, index) => (
					<li class="card reveal" style={`--i: ${index}`}>
						<span class="category">{project.data.category}</span>
						<h3>{project.data.name}</h3>
						<p>{project.data.description}</p>
						<ul class="tags">
							{project.data.techStack.map((tech) => <li>{tech}</li>)}
						</ul>
						<div class="links">
							<a href={`/projects/${project.id}/`}>Details →</a>
							{project.data.githubUrl && <a href={project.data.githubUrl} target="_blank" rel="noreferrer">GitHub →</a>}
							{project.data.liveUrl && <a href={project.data.liveUrl} target="_blank" rel="noreferrer">Live →</a>}
						</div>
					</li>
				))}
			</ul>
		</section>
	)}

	{latestPost && (
		<section class="latest-post">
			<h2>Latest from the blog</h2>
			<a href={`/blog/${latestPost.id}/`}>{latestPost.data.title} →</a>
		</section>
	)}
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-6) 0;
	}

	@media (max-width: 800px) {
		.hero {
			grid-template-columns: 1fr;
		}
	}

	.hero h1 {
		font-size: 40px;
		margin-bottom: var(--space-3);
	}

	.hero .lede {
		color: var(--text-secondary);
		font-size: 18px;
	}

	.cta-row {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding-top: var(--space-4);
		font-family: var(--font-heading);
	}

	.cta,
	.cta-ghost {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 var(--space-3);
		border-radius: 6px;
		font-size: 14px;
	}

	.cta {
		background: var(--accent);
		color: #fff;
	}

	.cta:hover {
		text-decoration: none;
		filter: brightness(1.1);
	}

	.cta-ghost {
		border: 1px solid var(--border);
		color: var(--text-primary);
	}

	.cta-ghost:hover {
		text-decoration: none;
		border-color: var(--accent);
	}

	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-bottom: var(--space-3);
	}

	.section-head h2,
	.latest-post h2 {
		font-size: 20px;
	}

	.section-head a {
		font-family: var(--font-heading);
		font-size: 14px;
	}

	.featured {
		padding-bottom: var(--space-6);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-3);
		list-style: none;
	}

	.card {
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: var(--space-3);
		background: var(--bg-elevated);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		transition: border-color 0.15s ease, transform 0.15s ease;
	}

	.card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.category {
		font-family: var(--font-code);
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--accent-text);
	}

	.card h3 {
		font-size: 16px;
	}

	.card p {
		color: var(--text-secondary);
		font-size: 14px;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		list-style: none;
		font-family: var(--font-code);
		font-size: 12px;
		color: var(--text-secondary);
		padding-top: var(--space-1);
	}

	.tags li {
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 2px 6px;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding-top: var(--space-1);
		font-family: var(--font-heading);
		font-size: 14px;
	}

	.latest-post {
		padding-bottom: var(--space-6);
	}

	.latest-post a {
		font-size: 16px;
	}

	@media (prefers-reduced-motion: reduce) {
		.card:hover {
			transform: none;
		}
	}
</style>
