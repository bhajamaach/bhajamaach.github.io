---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.name} — Kanishka Das`} description={project.data.description}>
	<article>
		<a class="back-link" href="/projects">&larr; back to projects</a>

		{project.data.coverImage && (
			<img src={project.data.coverImage} alt="" class="cover" />
		)}

		<span class="category">{project.data.category}</span>
		<h1>{project.data.name}</h1>
		<p class="description">{project.data.description}</p>

		<ul class="tags">
			{project.data.techStack.map((tech) => <li>{tech}</li>)}
		</ul>

		<div class="links">
			{project.data.githubUrl && <a class="cta" href={project.data.githubUrl} target="_blank" rel="noreferrer">GitHub →</a>}
			{project.data.liveUrl && <a class="cta-ghost" href={project.data.liveUrl} target="_blank" rel="noreferrer">Live →</a>}
		</div>

		<div class="prose">
			<Content />
		</div>
	</article>
</Layout>

<style>
	article {
		max-width: var(--max-width-prose);
		margin: 0 auto;
		padding: var(--space-5) 0 var(--space-6);
	}

	.back-link {
		display: inline-block;
		font-family: var(--font-heading);
		font-size: 14px;
		color: var(--text-secondary);
		padding-bottom: var(--space-3);
	}

	.back-link:hover {
		color: var(--accent-text);
	}

	.cover {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 8px;
		margin-bottom: var(--space-3);
	}

	.category {
		display: block;
		font-family: var(--font-code);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--accent-text);
	}

	h1 {
		font-size: 32px;
		padding: var(--space-1) 0 var(--space-2);
	}

	.description {
		color: var(--text-secondary);
		font-size: 17px;
		padding-bottom: var(--space-2);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		list-style: none;
		font-family: var(--font-code);
		font-size: 12px;
		color: var(--text-secondary);
		padding-bottom: var(--space-3);
	}

	.tags li {
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 2px 6px;
	}

	.links {
		display: flex;
		gap: var(--space-2);
		font-family: var(--font-heading);
		padding-bottom: var(--space-4);
	}

	.cta,
	.cta-ghost {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 var(--space-3);
		border-radius: 6px;
		font-size: 14px;
	}

	.cta {
		background: var(--accent);
		color: #fff;
	}

	.cta:hover {
		text-decoration: none;
		filter: brightness(1.1);
	}

	.cta-ghost {
		border: 1px solid var(--border);
		color: var(--text-primary);
	}

	.cta-ghost:hover {
		text-decoration: none;
		border-color: var(--accent);
	}

	.prose :global(p) {
		padding-bottom: var(--space-2);
	}

	.prose :global(img) {
		border-radius: 8px;
		margin-bottom: var(--space-2);
	}

	.prose :global(a) {
		text-decoration: underline;
	}

	.prose :global(code) {
		font-size: 0.9em;
	}
</style>
