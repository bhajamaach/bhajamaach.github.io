---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);

const siteURL = Astro.site?.toString().replace(/\/$/, '') ?? '';
const projectSchema = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.data.name,
	description: project.data.description,
	keywords: project.data.techStack.join(', '),
	author: { '@id': `${siteURL}/#person` },
	...(project.data.githubUrl && { codeRepository: project.data.githubUrl }),
	...(project.data.liveUrl && { url: project.data.liveUrl }),
	...(project.data.coverImage && { image: new URL(project.data.coverImage, Astro.site).toString() }),
};
---

<Layout title={`${project.data.name} — Kanishka Das`} description={project.data.description} image={project.data.coverImage}>
	<script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />
	<article>
		<a class="back-link" href="/projects">&larr; back to projects</a>

		{project.data.coverImage && (
			<img src={project.data.coverImage} alt={`Screenshot of ${project.data.name}`} class="cover" />
		)}

		<span class="category">{project.data.category}</span>
		<h1>{project.data.name}</h1>
		<p class="description">{project.data.description}</p>

		<ul class="tags">
			{project.data.techStack.map((tech) => <li>{tech}</li>)}
		</ul>

		<div class="links">
			{project.data.githubUrl && (
				<a class="cta" href={project.data.githubUrl} target="_blank" rel="noreferrer">
					<svg class="gh-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
						<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
					</svg>
					GitHub →
				</a>
			)}
			{project.data.liveUrl && <a class="cta-ghost" href={project.data.liveUrl} target="_blank" rel="noreferrer">Live →</a>}
		</div>

		<div class="prose">
			<Content />
		</div>
	</article>
</Layout>

<style>
	article {
		max-width: var(--max-width-prose);
		margin: 0 auto;
		padding: var(--space-5) 0 var(--space-6);
	}

	.back-link {
		display: inline-block;
		font-family: var(--font-heading);
		font-size: 14px;
		color: var(--text-secondary);
		padding-bottom: var(--space-3);
	}

	.back-link:hover {
		color: var(--accent-text);
	}

	.cover {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 8px;
		margin-bottom: var(--space-3);
	}

	.category {
		display: block;
		font-family: var(--font-code);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--accent-text);
	}

	h1 {
		font-size: 32px;
		padding: var(--space-1) 0 var(--space-2);
	}

	.description {
		color: var(--text-secondary);
		font-size: 17px;
		padding-bottom: var(--space-2);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		list-style: none;
		font-family: var(--font-code);
		font-size: 12px;
		color: var(--text-secondary);
		padding-bottom: var(--space-3);
	}

	.tags li {
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 2px 6px;
	}

	.links {
		display: flex;
		gap: var(--space-2);
		font-family: var(--font-heading);
		padding-bottom: var(--space-4);
	}

	.cta,
	.cta-ghost {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 var(--space-3);
		border-radius: 6px;
		font-size: 14px;
	}

	.gh-icon {
		flex-shrink: 0;
	}

	.cta {
		background: var(--accent);
		color: #fff;
	}

	.cta:hover {
		text-decoration: none;
		filter: brightness(1.1);
	}

	.cta-ghost {
		border: 1px solid var(--border);
		color: var(--text-primary);
	}

	.cta-ghost:hover {
		text-decoration: none;
		border-color: var(--accent);
	}

	.prose :global(p) {
		padding-bottom: var(--space-2);
	}

	.prose :global(img) {
		border-radius: 8px;
		margin-bottom: var(--space-2);
	}

	.prose :global(a) {
		text-decoration: underline;
	}

	.prose :global(code) {
		font-size: 0.9em;
	}
</style>
