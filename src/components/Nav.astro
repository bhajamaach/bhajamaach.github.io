---
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
const links = [
	{ href: '/projects', label: 'projects' },
	{ href: '/blog', label: 'blog' },
	{ href: '/contact', label: 'contact' },
	{ href: '/resume.pdf', label: 'resume', external: true },
];
---

<header class="site-nav">
	<div class="site-nav-inner">
		<a class="logo" href="/">kanishka</a>
		<div class="links">
			{links.map((link) => (
				<a
					href={link.href}
					aria-current={pathname === link.href ? 'page' : undefined}
					target={link.external ? '_blank' : undefined}
					rel={link.external ? 'noreferrer' : undefined}
				>{link.label}</a>
			))}
			<ThemeToggle />
		</div>
		<div class="mobile-controls">
			<ThemeToggle />
			<button
				class="menu-toggle"
				id="nav-menu-toggle"
				aria-expanded="false"
				aria-controls="nav-menu-panel"
				aria-label="Toggle navigation menu"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>
	<div class="menu-panel" id="nav-menu-panel">
		{links.map((link) => (
			<a
				href={link.href}
				aria-current={pathname === link.href ? 'page' : undefined}
				target={link.external ? '_blank' : undefined}
				rel={link.external ? 'noreferrer' : undefined}
			>{link.label}</a>
		))}
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-menu-toggle');
	const panel = document.getElementById('nav-menu-panel');

	if (toggle && panel) {
		toggle.addEventListener('click', () => {
			const isOpen = panel.classList.toggle('open');
			toggle.classList.toggle('open', isOpen);
			toggle.setAttribute('aria-expanded', String(isOpen));
		});

		panel.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).tagName === 'A') {
				panel.classList.remove('open');
				toggle.classList.remove('open');
				toggle.setAttribute('aria-expanded', 'false');
			}
		});

		document.addEventListener('click', (event) => {
			if (!panel.classList.contains('open')) return;
			if (event.target instanceof Node && !panel.contains(event.target) && !toggle.contains(event.target)) {
				panel.classList.remove('open');
				toggle.classList.remove('open');
				toggle.setAttribute('aria-expanded', 'false');
			}
		});
	}
</script>

<style>
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		background: color-mix(in srgb, var(--bg) 70%, transparent);
		backdrop-filter: blur(10px) saturate(1.2);
		border-bottom: 1px solid var(--border);
	}

	@supports not (backdrop-filter: blur(1px)) {
		.site-nav {
			-webkit-backdrop-filter: blur(10px) saturate(1.2);
		}
	}

	.site-nav-inner {
		display: flex;
		flex-wrap: nowrap;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-2);
		width: 100%;
		max-width: var(--max-width-page);
		margin: 0 auto;
		padding: var(--space-3);
		overflow-x: auto;
		scrollbar-width: none;
	}

	.site-nav-inner::-webkit-scrollbar {
		display: none;
	}

	.logo {
		flex-shrink: 0;
		font-family: var(--font-heading);
		font-weight: 500;
		color: var(--text-primary);
	}

	.logo:hover {
		text-decoration: none;
		color: var(--accent-text);
	}

	.links {
		display: flex;
		flex-wrap: nowrap;
		flex-shrink: 0;
		align-items: center;
		gap: var(--space-3);
		font-family: var(--font-heading);
		font-size: 14px;
	}

	.links a {
		position: relative;
		flex-shrink: 0;
		white-space: nowrap;
		color: var(--text-primary);
		padding: var(--space-1) 0 var(--space-1) 0;
		transition: color 0.15s ease, padding-left 0.15s ease;
	}

	.links a::before {
		content: '>';
		position: absolute;
		left: -0.9em;
		color: var(--accent-text);
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity 0.15s ease, transform 0.15s ease;
	}

	.links a:hover,
	.links a[aria-current='page'] {
		color: var(--accent-text);
		padding-left: 0.9em;
	}

	.links a:hover::before,
	.links a[aria-current='page']::before {
		opacity: 1;
		transform: translateX(0);
	}

	.mobile-controls {
		display: none;
		align-items: center;
		gap: var(--space-2);
	}

	.menu-toggle {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 32px;
		height: 32px;
		padding: 0;
		background: none;
		border: none;
		cursor: pointer;
	}

	.menu-toggle span {
		display: block;
		width: 18px;
		height: 2px;
		background: var(--text-primary);
		border-radius: 2px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.menu-toggle.open span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.menu-toggle.open span:nth-child(2) {
		opacity: 0;
	}

	.menu-toggle.open span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	.menu-panel {
		display: none;
		flex-direction: column;
		max-height: 0;
		overflow: hidden;
		border-top: 1px solid transparent;
		font-family: var(--font-heading);
		font-size: 14px;
		transition: max-height 0.2s ease;
	}

	.menu-panel.open {
		max-height: 300px;
		border-top-color: var(--border);
	}

	.menu-panel a {
		position: relative;
		padding: var(--space-3);
		color: var(--text-primary);
		border-bottom: 1px solid var(--border);
		transition: color 0.15s ease, padding-left 0.15s ease;
	}

	.menu-panel a::before {
		content: '>';
		position: absolute;
		left: var(--space-2);
		color: var(--accent-text);
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity 0.15s ease, transform 0.15s ease;
	}

	.menu-panel a:last-child {
		border-bottom: none;
	}

	.menu-panel a:hover,
	.menu-panel a[aria-current='page'] {
		color: var(--accent-text);
		padding-left: calc(var(--space-3) + 0.9em);
	}

	.menu-panel a:hover::before,
	.menu-panel a[aria-current='page']::before {
		opacity: 1;
		transform: translateX(0);
	}

	@media (max-width: 560px) {
		.links {
			display: none;
		}

		.mobile-controls {
			display: flex;
		}

		.menu-panel {
			display: flex;
		}
	}
</style>
