---
// Third-party transactional provider only — set PUBLIC_BUTTONDOWN_USERNAME to enable.
// See .env.example. No custom email-sending infrastructure lives in this repo (NFR-5.3 / FR-4.5).
const username = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME;
---

<form id="email-capture" class:list={{ 'is-disabled': !username }} data-username={username}>
	<label for="email-input">Get an email when a new post goes up.</label>
	<div class="row">
		<input
			id="email-input"
			name="email"
			type="email"
			inputmode="email"
			autocomplete="email"
			placeholder="you@example.com"
			required
			disabled={!username}
		/>
		<button type="submit" disabled={!username}>Notify me</button>
	</div>
	<p class="status" role="status" aria-live="polite"></p>
</form>

<style>
	form {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-3);
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--bg-elevated);
	}

	label {
		font-size: 14px;
		color: var(--text-secondary);
	}

	.row {
		display: flex;
		gap: var(--space-2);
	}

	input {
		flex: 1;
		min-height: 44px;
		padding: 0 var(--space-2);
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--bg);
		color: var(--text-primary);
		font-family: var(--font-body);
		font-size: 15px;
	}

	input:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	button {
		min-height: 44px;
		padding: 0 var(--space-3);
		border: 1px solid var(--accent);
		border-radius: 6px;
		background: var(--accent);
		color: var(--bg);
		font-family: var(--font-heading);
		font-weight: 500;
		cursor: pointer;
		white-space: nowrap;
	}

	button:hover {
		filter: brightness(1.08);
	}

	form.is-disabled button,
	form.is-disabled input {
		cursor: not-allowed;
		opacity: 0.6;
	}

	.status {
		font-size: 13px;
		min-height: 1em;
		color: var(--text-secondary);
	}

	.status[data-state='error'] {
		color: #d14343;
	}

	.status[data-state='success'] {
		color: var(--accent-text);
	}
</style>

<script>
	const form = document.getElementById('email-capture') as HTMLFormElement | null;
	const username = form?.dataset.username;

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const status = form.querySelector('.status') as HTMLParagraphElement;
		const input = form.querySelector('#email-input') as HTMLInputElement;
		const email = input.value.trim();

		const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
		if (!emailPattern.test(email)) {
			status.textContent = 'Enter a valid email address.';
			status.dataset.state = 'error';
			return;
		}

		if (!username) {
			status.textContent = 'Subscriptions are not open yet.';
			status.dataset.state = 'error';
			return;
		}

		status.textContent = 'Submitting…';
		status.dataset.state = '';

		try {
			const response = await fetch(`https://buttondown.com/api/emails/embed-subscribe/${username}`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
				body: new URLSearchParams({ email }),
			});

			if (response.ok) {
				status.textContent = "Subscribed — you'll hear about new posts.";
				status.dataset.state = 'success';
				form.reset();
			} else {
				status.textContent = 'Something went wrong. Try again later.';
				status.dataset.state = 'error';
			}
		} catch {
			status.textContent = 'Network error. Try again later.';
			status.dataset.state = 'error';
		}
	});
</script>
